# SirTrav A2A Studio - Environment Variables
# Copy this file to .env only when you intentionally need local development secrets.
# Netlify site environment variables are the canonical runtime source of truth for
# deployed proof runs, shared team behavior, and production validation.
# Run: just validate-env  — checks the current shell/.env only, shows masked previews,
#                           and exits 1 if required local keys are missing
#
# SCOPE KEY:
#   [NETLIFY] = Set in Netlify Dashboard > Site > Environment Variables
#   [LOCAL]   = Set in local .env for `netlify dev`
#   [AUTO]    = Auto-injected by Netlify at build/runtime — do not set manually
#
# Limited License (inner circle — bidirectional HOT rail, read/write):
#   CV_IDENTITY_URL, VECTOR_ENGINE_URL, all social posting keys
# Unlimited License (public pipe — one-way COLD rail, pay-per-use):
#   Public chatbot via CV repo chat.ts

# =============================================================================
# CV IDENTITY WIRE — Wire 2 reverse feed (R.-Scott-Echols-CV → SirTrav)
# Required: agents must read CV identity BEFORE writing any post or brief
# =============================================================================

# [NETLIFY+LOCAL] CV truth pack endpoints (read-only — COLD rail)
CV_IDENTITY_URL=https://robertoscottecholscv.netlify.app/api/identity.json
CV_TRUTH_PACK_URL=https://robertoscottecholscv.netlify.app/api/identity.json

# [NETLIFY+LOCAL] pgvector RAG engine (Cloud Run — semantic retrieval)
VECTOR_ENGINE_URL=https://rse-retrieval-zrmkhygpwa-uc.a.run.app

# =============================================================================
# CORE AI SERVICES — Required for production pipeline
# =============================================================================

# [NETLIFY+LOCAL] OpenAI — Director/Writer/Curator agents
OPENAI_API_KEY=

# [NETLIFY+LOCAL] Gemini — embedding + narration alternative
GEMINI_API_KEY=

# [NETLIFY+LOCAL] Grok — cost-optimized validation (4-30x cheaper than flagship)
GROK_API_KEY=

# [NETLIFY+LOCAL] OpenRouter — fallback AI routing (optional)
OPENROUTER_API_KEY=

# [NETLIFY+LOCAL] ElevenLabs — Voice Agent narration
ELEVENLABS_API_KEY=

# [NETLIFY+LOCAL] Suno — Composer Agent music generation
SUNO_API_KEY=
SUNO_API_URL=https://api.suno.ai/v1

# =============================================================================
# SOCIAL MEDIA PUBLISHING — MVP: X/Twitter + YouTube
# =============================================================================

# [NETLIFY] X/Twitter OAuth 1.0a (User Context — required for posting)
# Get from: https://developer.x.com/en/portal/dashboard
# IMPORTANT: All 4 keys must come from the SAME developer app
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_SECRET=

# [NETLIFY] YouTube Data API v3
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=

# [NETLIFY] LinkedIn Marketing API v2 (optional)
# Get from: https://www.linkedin.com/developers/apps
# Request "Share on LinkedIn" product for w_member_social scope
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_PERSON_URN=
LINKEDIN_ORGANIZATION_ID=

# [NETLIFY] TikTok Content Posting API (optional)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_ACCESS_TOKEN=
TIKTOK_REFRESH_TOKEN=

# [NETLIFY] Instagram Graph API (optional, requires Facebook Business)
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# =============================================================================
# VIDEO / MEDIA RENDERING
# =============================================================================

# [NETLIFY] FFmpeg Service URL (cloud rendering)
FFMPEG_SERVICE_URL=

# =============================================================================
# STORAGE — Netlify Blobs (no AWS)
# =============================================================================

# [AUTO] Netlify Blobs — auto-injected by Netlify runtime
# NETLIFY_BLOBS_CONTEXT=  (do not set manually)

# [LOCAL] Netlify identity for local blob access via `netlify dev`
NETLIFY_SITE_ID=
NETLIFY_API_TOKEN=
NETLIFY_AUTH_TOKEN=

# =============================================================================
# SECURITY & UTILITIES
# =============================================================================

# [NETLIFY+LOCAL] API authentication secret for start-pipeline
API_SECRET=

# [NETLIFY+LOCAL] Issue intake endpoint secret
ISSUE_INTAKE_SECRET=

# [NETLIFY+LOCAL] MCP endpoint token
MCP_SECRET_TOKEN=

# [NETLIFY+LOCAL] Share link signing secret
SHARE_SECRET=

# [NETLIFY] Bitly short URLs (optional)
BITLY_ACCESS_TOKEN=

# =============================================================================
# OBSERVABILITY
# =============================================================================

# [NETLIFY] Enable distributed tracing
TRACING_ENABLED=false

# =============================================================================
# DEVELOPMENT — Local only
# =============================================================================

# [LOCAL] Vault path for local development
VAULT_PATH=

# [AUTO] Netlify build context vars (auto-injected, listed for reference)
# URL=                    # Site URL
# BUILD_ID=               # Build identifier
# COMMIT_REF=             # Git commit SHA
# CONTEXT=                # deploy context (production/deploy-preview/branch-deploy)
# BRANCH=                 # Git branch name
# NETLIFY_SITE_DOMAIN=    # Site domain
# NETLIFY_DEV=            # "true" when running netlify dev
